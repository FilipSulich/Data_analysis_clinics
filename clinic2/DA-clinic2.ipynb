   "cell_type": "code",
   "execution_count": 544,
   "metadata": {},
   "outputs": [],
   "source": [
    "def process_data_gm1(data):\n",
    "\n",
    "    data = (\n",
    "        data\n",
    "        # -------------------\n",
    "        # Clean Data\n",
    "        # -------------------\n",
    "        .pipe(remove_outliers, \"house-area\", upper=300)\n",
    "\n",
    "        # -------------------\n",
