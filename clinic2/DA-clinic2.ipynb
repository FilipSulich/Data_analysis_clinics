    "X_train_gm3, y_train_gm3 = process_data_gm3(training_data)\n",
    "X_test_gm3, y_test_gm3 = process_data_gm3(testing_data)\n",
    "\n",
    "# Specify the model\n",
    "guidedmodel3 = lm.Lasso(copy_X=True)\n",
    "\n",
    "# Specify CV method and grid of regularization values\n",
    "five_fold_cv = KFold(n_splits=5)\n",
    "alphas = np.arange(0.001, 10, 0.5)\n",
    "\n",
    "rmses_gm3 = np.zeros(len(alphas))\n",
    "\n",
    "# Grid search over alphas\n",
    "for i, alpha in enumerate(alphas):\n",
    "    guidedmodel3.set_params(alpha=alpha)\n",
    "    model_rmse = 0\n",
    "\n",
    "    for train_index, test_index in five_fold_cv.split(X_train_gm3):\n",
    "        X_fold_train = X_train_gm3.iloc[train_index]\n",
    "        y_fold_train = y_train_gm3.iloc[train_index]\n",
    "        X_fold_test = X_train_gm3.iloc[test_index]   \n",
    "        y_fold_test = y_train_gm3.iloc[test_index]   \n",
    "\n",
    "        guidedmodel3.fit(X_fold_train, y_fold_train)\n",
    "        y_fold_predicted = guidedmodel3.predict(X_fold_test)\n",
    "\n",
    "        model_rmse += rmse(y_fold_test, y_fold_predicted)\n",
    "\n",
    "    rmses_gm3[i] = model_rmse / 5\n",
    "\n",
    "optimal_alpha_gm3 = alphas[rmses_gm3 == np.min(rmses_gm3)][0]\n",
    "\n",
    "guidedmodel3.set_params(alpha=optimal_alpha_gm3)\n",
    "guidedmodel3.fit(X_train_gm3, y_train_gm3)\n",
    "\n",
    "y_predicted_gm3 = guidedmodel3.predict(X_test_gm3)\n",
    "\n",
    "\n",
    "print(f\"The validation RMSE for this model with \"\n",
    "        f\"alpha={optimal_alpha_gm3} is {rmse(y_test_gm3, y_predicted_gm3):.2f}.\")"
   ]
